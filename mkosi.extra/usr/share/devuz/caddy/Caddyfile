# Вход в коробку. Свой сертификат (tls internal): корневой сертификат
# коробки ставится на ПК сотрудников при первой настройке (неделя 8).
{
	# API управления Caddy выключен: с сетью хоста он был бы открыт любому
	# процессу коробки и позволял переписать вход или унести ключ CA.
	admin off
}

https://devuz.local, https://localhost {
	tls internal
	# «Офис» (devuz-svc-office, 127.0.0.1:8100). Не установлен или не
	# отвечает — простая страница коробки.
	# Пометка «пришло снаружи» бывает только у внешнего входа ниже: в сети
	# офиса её не подделать.
	reverse_proxy 127.0.0.1:8100 {
		header_up -X-Devuz-Via
	}
	handle_errors {
		respond "DevUz OK" 200
	}
}

# Внешний вход: сюда и только сюда ведёт туннель (devuz-svc-cloudflared).
# Слушает только 127.0.0.1 (bind: адрес сайта в Caddy сам по себе слушает
# все адреса) — из сети офиса его не видно. Имя сайта любое: cloudflared
# присылает внешнее имя коробки (box-….devuz…). TLS снаружи держит
# Cloudflare. Каждый запрос помечается X-Devuz-Via: tunnel (подделанная
# клиентом метка затирается), адрес посетителя — из Cf-Connecting-IP (его
# ставит Cloudflare). Что пускать снаружи (события Meta, виджет сайта, сам
# «Офис» для телефонов — переключателем), решает «Офис».
http://:8180 {
	bind 127.0.0.1
	reverse_proxy 127.0.0.1:8100 {
		header_up X-Devuz-Via tunnel
		header_up X-Forwarded-For {http.request.header.Cf-Connecting-IP}
	}
	handle_errors {
		respond "DevUz: «Офис» недоступен" 503
	}
}

# Только для проверки здоровья (HealthCmd): отвечает «ok», больше ничего.
http://127.0.0.1:2080 {
	respond "ok" 200
}
