# Интерфейс и данные коробки: Caddy, PostgreSQL, «Ядро». Процессор и диск —
# в первую очередь им, память под ними защищена: «без фризов», даже когда
# модель ИИ работает на полную (на Лайт и Про память общая).
[Unit]
Description=DevUz: интерфейс и данные (приоритет)

[Slice]
CPUWeight=1000
IOWeight=1000
MemoryLow=1G
