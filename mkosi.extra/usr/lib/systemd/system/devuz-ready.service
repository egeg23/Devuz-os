# SPDX-License-Identifier: LGPL-2.1-or-later
[Unit]
Description=DevUz: система готова
Documentation=https://github.com/egeg23/devuz-os
# Отмечает готовность после старта основных служб. На неделе 2 сюда
# добавится systemd-bless-boot: загрузка засчитается, только если мы дошли
# до этой точки.
After=multi-user.target
Before=boot-complete.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/devuz/ready
StandardOutput=journal+console

[Install]
# boot-complete.target сам по себе не тянется без счёта загрузок
# (неделя 2), поэтому включаем ещё и от multi-user.target.
WantedBy=multi-user.target
WantedBy=boot-complete.target
