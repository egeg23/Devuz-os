# Проверка модели перед сервером модели (devuz-svc-llm): подпись манифеста и
# хеши файлов. Отдельной службой, а не ExecStartPre: так битая модель не
# перезапускается сторожем по кругу — сервер просто не стартует, сигнал
# один раз. Перезапуск сервера модели проверяет модель заново.
[Unit]
Description=DevUz: проверка модели (подпись и хеши)
DefaultDependencies=no
After=basic.target
Conflicts=shutdown.target
Before=shutdown.target
ConditionPathExists=/etc/devuz/llm-model
PartOf=devuz-svc-llm.service
OnFailure=devuz-alert@%n.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/devuz/models-verify
# Хеширование десятков ГБ — в фоне: интерфейс и база важнее.
Slice=devuz-ai.slice
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=30min
StandardOutput=journal+console
