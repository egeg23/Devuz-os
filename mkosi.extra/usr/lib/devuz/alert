#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# Служба $1 не поднялась после трёх попыток: записать сигнал (один на
# каждый такой случай), вывести строку DEVUZ-ALERT и назначить повтор.
set -eu
unit=${1:?служба}
dir=/var/lib/devuz/alerts
what="не поднимается после 3 попыток"
[ "$(systemctl show -p Type --value "$unit" 2>/dev/null)" = oneshot ] && what="не выполнилась"
# Сначала строка в журнал: если диск полон или только для чтения, запись
# в файл не удастся, а сигнал и повтор всё равно должны быть.
echo "DEVUZ-ALERT $unit $what"
{ mkdir -p "$dir" && echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $unit $what" >>"$dir/$unit"; } 2>/dev/null ||
    echo "DEVUZ-ALERT $unit: не удалось записать сигнал в $dir"
# Человека в офисе нет: через 15 минут попробовать ещё раз (окно счёта
# попыток к тому времени прошло) — но не больше 3 раз за загрузку и не для
# разовых служб (oneshot: проверка модели, обновление): им повтор ничего не
# даст, кроме лишней нагрузки (например, пересчёта хешей десятков ГБ).
[ "$(systemctl show -p Type --value "$unit" 2>/dev/null)" = oneshot ] && exit 0
n=/run/devuz/alerts/$unit.retries
mkdir -p /run/devuz/alerts
tries=$(cat "$n" 2>/dev/null || echo 0)
[ "$tries" -lt 3 ] || { echo "DEVUZ-ALERT $unit: 3 повтора за эту загрузку не помогли — больше не пробую"; exit 0; }
# Попытку засчитываем, только если повтор действительно назначен.
if systemd-run --quiet --collect --unit="devuz-retry-${unit%.service}-$((tries + 1))" --on-active=15min \
    /usr/bin/systemctl --no-block start "$unit"; then
    echo $((tries + 1)) >"$n"
else
    echo "DEVUZ-ALERT $unit: повтор через 15 мин назначить не удалось"
fi
