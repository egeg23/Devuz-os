#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# Перед запуском PostgreSQL: (1) пароль суперпользователя — создать один раз
# (0600, в /etc/devuz/postgres); (2) мажорная версия данных совпадает с
# образом. Другой мажор на тех же данных не стартует и портит попытки
# сторожа — останавливаемся сразу с понятным сигналом, данные не трогаем.
set -eu
want=${1:?мажорная версия}
data=/var/lib/devuz/postgres
pw=/etc/devuz/postgres/password
if [ ! -s "$pw" ]; then
    mkdir -p "${pw%/*}"; chmod 700 "${pw%/*}"
    ( umask 077; head -c 32 /dev/urandom | base64 | tr -d '\n=/+' >"$pw.new" )
    mv "$pw.new" "$pw"
    echo "DEVUZ-POSTGRES пароль суперпользователя создан: $pw"
fi
if [ -s "$data/PG_VERSION" ]; then
    have=$(cat "$data/PG_VERSION")
    if [ "$have" != "$want" ]; then
        echo "DEVUZ-ALERT PostgreSQL: данные версии $have, а образ — $want. Нужна миграция (pg_dumpall → новая база); служба не запущена, данные не тронуты."
        exit 1
    fi
fi
# Данные, созданные ранними сборками (до аудита В), могли остаться со
# входом «trust» (без пароля для любого процесса с доступом к сокету).
# Такую базу не запускаем: в коробках её нет, но молча стартовать нельзя.
if [ -s "$data/pg_hba.conf" ] && grep -Eq '^[[:space:]]*[^#[:space:]].*[[:space:]]trust[[:space:]]*$' "$data/pg_hba.conf"; then
    echo "DEVUZ-ALERT PostgreSQL: в $data/pg_hba.conf есть вход «trust» — служба не запущена. Замените trust на peer/scram-sha-256."
    exit 1
fi
