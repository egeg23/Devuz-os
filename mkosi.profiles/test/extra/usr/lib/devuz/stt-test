#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# Тест распознавания речи (только тестовый образ, режим devuz.test=stt):
#  1. маленькая модель whisper (small, 5 бит) с подписанным манифестом
#     загружается, сервер речи поднимается;
#  2. у сервера речи нет порта на коробке — только сокет 0600 для «Ядра»;
#  3. через «Ядро» (задача stt): русская фраза (голосовое OGG/Opus, как в
#     Telegram) и узбекская (WAV) → текст; замер времени;
#  4. манифест с неверной подписью — сервер речи не стартует.
# Фразы синтезированы при сборке (espeak-ng) — в тест идут их файлы.
# Потом — обычная самопроверка.
set -u
export LC_ALL=C.UTF-8
say() { echo "DEVUZ-STT-TEST $*"; }
fail=0
src=/usr/share/devuz/test-models/whisper-small-q5
speech=/usr/share/devuz/test-models/speech
models=/var/lib/devuz/models
api=http://127.0.0.1:8090/v1
stt=devuz-svc-stt.service
use() { echo "$1" >/etc/devuz/stt-model; systemctl reset-failed devuz-stt-verify.service "$stt" 2>/dev/null; }

mkdir -p "$models"
cp -a "$src" "$models/whisper-small-q5"

# 1. Хорошая модель.
use whisper-small-q5
t0=$(date +%s)
if systemctl start "$stt"; then
    say "STT_UP ok: подпись и хеши верны, сервер речи поднялся за $(( $(date +%s) - t0 )) с"
else
    say "ERROR сервер речи не поднялся:"; journalctl -b -u devuz-stt-verify -u "$stt" --no-pager -n 40; fail=1
fi

# 2. Только сокет: порта на коробке нет, сокет — root и 0600.
if [ -z "$(ss -ltnH 'sport = :8082')" ] && [ "$(stat -c '%a %U' /run/devuz/stt/stt.sock 2>/dev/null)" = "600 root" ]; then
    say "SOCKET_ONLY ok: порта 8082 на коробке нет, сокет 0600 root"
else
    say "ERROR сервер речи виден не только через сокет: $(ss -ltnH 'sport = :8082') $(stat -c '%a %U' /run/devuz/stt/stt.sock 2>&1)"; fail=1
fi

# 3. Речь → текст через «Ядро».
tok=$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')
mkdir -p /etc/devuz/core/apps.d
printf '{"token_sha256":"%s","tasks":["stt"],"priority":"staff"}\n' "$(printf %s "$tok" | sha256sum | cut -d' ' -f1)" >/etc/devuz/core/apps.d/test-stt.json
systemctl reload devuz-svc-core.service; sleep 1
hear() { # ключ файл язык слова-для-проверки
    local key=$1 file=$2 lang=$3 words=$4 t0 c ms text dur
    t0=$(date +%s%N)
    c=$(curl -s -m 600 -o /tmp/stt.out -w '%{http_code}' -H "authorization: Bearer $tok" \
        --data-binary "@$file" "$api/audio/transcriptions?model=stt&language=$lang")
    ms=$(( ($(date +%s%N) - t0) / 1000000 ))
    text=$(sed -n 's/^{"text":"\([^"]*\)".*/\1/p' /tmp/stt.out | head -c 200)
    dur=$(sed -n 's/.*"duration":\([0-9.]*\).*/\1/p' /tmp/stt.out)
    if [ "$c" = 200 ] && printf '%s' "$text" | grep -qiE "$words"; then
        say "$key ok: ${ms} мс на ${dur:-?} с записи, текст: «$text»"
    else
        say "ERROR $key: $c, текст «$text», ответ $(head -c 300 /tmp/stt.out)"; fail=1
    fi
}
hear RU_TEXT "$speech/ru.ogg" ru 'завтра|совещани|проект'
hear UZ_TEXT "$speech/uz.wav" uz 'salom|салом|ertaga|эртага|soat|соат|yig|йиғ|йиг'
# Без токена с задачей stt — нельзя.
c=$(curl -s -m 10 -o /dev/null -w '%{http_code}' --data-binary "@$speech/uz.wav" "$api/audio/transcriptions?model=stt")
[ "$c" = 401 ] && say "NEED_TOKEN ok" || { say "ERROR без токена: $c"; fail=1; }
rm -f /etc/devuz/core/apps.d/test-stt.json; systemctl reload devuz-svc-core.service
systemctl stop "$stt"

# 4. Битая подпись — сервер речи не стартует.
rm -rf "${models:?}/bad-stt"; cp -a "$models/whisper-small-q5" "$models/bad-stt"
sed -i 's/^name: .*/name: bad-stt/' "$models/bad-stt/MANIFEST"
use bad-stt
if systemctl start "$stt" 2>/dev/null; then say "ERROR модель речи с чужой подписью загрузилась"; fail=1; systemctl stop "$stt"
else
    why=$(journalctl -b -u devuz-stt-verify --no-pager -o cat | grep -F 'DEVUZ-MODELS ERROR bad-stt' | grep -F 'BAD signature' | tail -n1)
    [ -n "$why" ] && say "BAD_SIG_REFUSED ok: ${why#DEVUZ-MODELS ERROR }" || { say "ERROR отказ не по подписи: $(journalctl -b -u devuz-stt-verify --no-pager -o cat | tail -n2)"; fail=1; }
fi
rm -rf "${models:?}/bad-stt"

# Убрать за собой.
rm -f /etc/devuz/stt-model
systemctl stop "$stt" 2>/dev/null
systemctl reset-failed devuz-stt-verify.service "$stt" 'devuz-alert@*' 2>/dev/null
if [ "$fail" -eq 0 ]; then say OK; else say FAIL; fi
systemctl start --no-block devuz-selftest.service
