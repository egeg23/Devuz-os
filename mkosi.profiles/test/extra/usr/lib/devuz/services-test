#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# Тест служб (только тестовый образ, режим devuz.test=services):
# первая загрузка — PostgreSQL и Caddy поднялись из образов в /usr (без сети),
# запрос в базу и https работают, пишем строку в базу и перезагружаемся;
# вторая — службы снова работают, строка на месте. Перед перезагрузкой
# подменяем образ PostgreSQL в хранилище (чужой образ под тем же именем):
# после загрузки коробка должна вернуть образ из /usr. Потом самопроверка.
set -u
say() { echo "DEVUZ-SERVICES $*"; }
fail=0
mark=/var/lib/devuz/test-services-boot
wait_active() { for _ in $(seq 300); do systemctl is-active --quiet "$1" && return 0; sleep 1; done; return 1; }
psql() { podman exec devuz-postgres psql -U postgres -tAc "$1"; }

for u in devuz-svc-postgres.service devuz-svc-caddy.service; do
    if wait_active "$u"; then
        say "ACTIVE $u"
    else
        say "ERROR не поднялась $u:"; journalctl -b -u "$u" --no-pager -n 30; fail=1
    fi
done

# Образы — из /usr, без сети: реестр сборки к этому времени погашен, а у
# служб Pull=never.
if [ ! -e "$mark" ]; then
    n=$(journalctl -b -u devuz-images.service --no-pager | grep -c 'загружен из /usr' || true)
    if [ "$n" -ge 3 ]; then say "IMAGES_FROM_USR ok: $n образа из /usr, сеть не нужна"; else say "ERROR из /usr загружено образов: $n"; fail=1; fi
fi

r=$(psql 'select 40 + 2' 2>&1)
if [ "$r" = 42 ]; then say "POSTGRES_QUERY ok"; else say "ERROR запрос в базу: $r"; fail=1; fi

body=$(curl -s --cacert /var/lib/devuz/caddy/caddy/pki/authorities/local/root.crt https://localhost/ 2>&1)
if [ "$body" = "DevUz OK" ]; then
    say "CADDY_HTTPS ok (сертификат коробки)"
else
    say "ERROR https: $body"; fail=1
fi

if [ ! -e "$mark" ]; then
    psql "create table if not exists devuz_test(v text); insert into devuz_test values ('пережила перезагрузку')" >/dev/null
    touch "$mark"
    podman tag ghcr.io/egeg23/devuz-caddy:2 ghcr.io/egeg23/devuz-postgres:17
    if [ "$fail" -eq 0 ]; then say "FIRST_BOOT ok → подменили образ PostgreSQL, перезагрузка"; systemctl reboot; exit 0; fi
else
    v=$(psql 'select v from devuz_test' 2>&1)
    if [ "$v" = "пережила перезагрузку" ]; then say "DATA_SURVIVED ok"; else say "ERROR после перезагрузки: $v"; fail=1; fi
    want=$(awk '$2=="ghcr.io/egeg23/devuz-postgres:17" {print $4}' /usr/share/devuz/images/images.list)
    have=$(podman image inspect --format '{{.Id}}' ghcr.io/egeg23/devuz-postgres:17)
    if [ -n "$want" ] && [ "$have" = "$want" ] && journalctl -b -u devuz-images.service --no-pager | grep -q 'devuz-postgres:17 в хранилище не тот'; then
        say "IMAGE_TAMPER_RESTORED ok: подменённый образ заменён образом из /usr"
    else
        say "ERROR подмена образа пережила перезагрузку: ${have:0:12}, ждали ${want:0:12}"; fail=1
    fi
fi

if [ "$fail" -eq 0 ]; then say OK; else say FAIL; fi
systemctl start --no-block devuz-selftest.service
