#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# Тест ключей диска (только тестовый образ, режим devuz.test=luks):
#  1. ключ из TPM открывает root; ключ восстановления уже заведён службой
#     devuz-recovery-key при первой загрузке (боевой путь);
#  2. меняем PCR 7 (так меняется состояние Secure Boot, когда в прошивке
#     чужие ключи) — TPM больше не отдаёт ключ;
#  3. ключ восстановления открывает root и без TPM.
# Потом — обычная самопроверка.
set -u
say() { echo "DEVUZ-LUKS $*"; }
fail=0

dev=""
for d in /sys/block/dm-*/dm; do
    [ -r "$d/name" ] && [ "$(cat "$d/name")" = root ] || continue
    for s in "$d"/../slaves/*; do dev="/dev/${s##*/}"; done
done
[ -b "$dev" ] || { say "ERROR не нашёл раздел под /dev/mapper/root"; say FAIL; exit 1; }
say "DEVICE $dev"

# 1. TPM открывает том сам (токен в заголовке), и ключ восстановления уже
#    заведён службой devuz-recovery-key при первой загрузке — ровно один.
systemctl start devuz-recovery-key.service 2>/dev/null || true
if cryptsetup open --test-passphrase --token-only "$dev" </dev/null 2>/tmp/tpm.err; then
    say "TPM_UNLOCK ok"
else
    say "ERROR TPM не открывает root:"; sed 's/^/  /' /tmp/tpm.err; fail=1
fi
rkey=$(cat /var/lib/devuz/recovery-key 2>/dev/null || true)
ntok=$(cryptsetup luksDump "$dev" | grep -c 'systemd-recovery' || true)
if [[ "$rkey" =~ ^([cbdefghijklnrtuv]{8}-){7}[cbdefghijklnrtuv]{8}$ ]] && [ "$ntok" = 1 ] &&
   [ "$(stat -c %a /var/lib/devuz/recovery-key)" = 600 ] && ! journalctl -b --no-pager | grep -qF "$rkey"; then
    say "RECOVERY_ENROLLED ok (служба при первой загрузке, один ключ, 0600, не в журнале)"
else
    say "ERROR ключ восстановления: файл «${rkey:0:8}…», токенов $ntok, права $(stat -c %a /var/lib/devuz/recovery-key 2>/dev/null)"
    journalctl -b -u devuz-recovery-key --no-pager -n 5 | sed 's/^/  /'
    fail=1
fi
# Повторный запуск не заводит второй ключ.
rm -f /var/lib/devuz/.recovery-key; /usr/lib/devuz/recovery-key >/dev/null
[ "$(cryptsetup luksDump "$dev" | grep -c 'systemd-recovery')" = 1 ] && [ "$(cat /var/lib/devuz/recovery-key)" = "$rkey" ] ||
    { say "ERROR повторный запуск завёл второй ключ или сменил файл"; fail=1; }

# TRIM сквозь LUKS (devuz-luks-discard при первой загрузке, аудит Б).
if cryptsetup luksDump "$dev" | grep -q 'allow-discards' && systemctl is-enabled --quiet fstrim.timer; then
    say "LUKS_DISCARD ok (fstrim.timer включён)"
else
    say "ERROR TRIM: allow-discards в заголовке или fstrim.timer — нет: $(journalctl -b -u devuz-luks-discard --no-pager -n 5 | tail -n 3)"; fail=1
fi

# 2. Другой PCR 7 — как при чужих ключах Secure Boot. Ключ из TPM не должен
# достаться никому.
/usr/lib/systemd/systemd-pcrextend --pcr=7 devuz-foreign-secure-boot || { say "ERROR не удалось изменить PCR 7"; fail=1; }
if systemd-cryptenroll --unlock-tpm2-device=auto --recovery-key "$dev" >/dev/null 2>/tmp/enroll2.err; then
    say "ERROR TPM отдал ключ при другом PCR 7"
    fail=1
elif grep -qE 'Failed to unseal secret using TPM2|No TPM2 metadata matching the current system state' /tmp/enroll2.err; then
    # Отказ именно TPM по политике (systemd 257), а не любая другая ошибка.
    say "PCR7_CHANGED_TPM_UNLOCK отказ (так и надо)"
    sed 's/^/  /' /tmp/enroll2.err | tail -n 3
else
    say "ERROR отказ, но не по политике TPM:"
    sed 's/^/  /' /tmp/enroll2.err
    fail=1
fi

# 3. Ключ восстановления открывает без TPM.
if [ -n "$rkey" ] && printf '%s' "$rkey" | cryptsetup open --test-passphrase --key-file=- "$dev"; then
    say "RECOVERY_OPEN ok"
else
    say "ERROR ключ восстановления не открывает root"
    fail=1
fi

# 4. Перезапечатка (как после обновления dbx): PCR 7 всё ещё «чужой» — служба
#    заводит слот TPM заново ключом восстановления, и TPM снова открывает сам.
#    Политика прежняя (PCR 7 + подписанная PCR 11), слот TPM — один.
/usr/lib/devuz/tpm-reseal
dump=$(cryptsetup luksDump --dump-json-metadata "$dev" | tr -d ' \n')
if cryptsetup open --test-passphrase --token-only "$dev" </dev/null 2>/tmp/reseal.err &&
   [ "$(grep -o '"type":"systemd-tpm2"' <<<"$dump" | wc -l)" = 1 ] && grep -qE '"tpm2(_|-)pubkey(_|-)pcrs":\[11\]' <<<"$dump" && grep -q '"tpm2-pcrs":\[7\]' <<<"$dump"; then
    say "TPM_RESEALED ok (новое состояние PCR 7, политика PCR 7 + подписанная 11, один слот)"
else
    say "ERROR перезапечатка: $(tail -n 2 /tmp/reseal.err 2>/dev/null) $(journalctl -b --no-pager | grep -m3 'DEVUZ-RESEAL' || true)"
    grep -oE '"tpm2[^]]*]' <<<"$dump" | sed 's/^/  /'
    fail=1
fi
# Второй запуск при рабочем TPM ничего не трогает.
before=$(cryptsetup luksDump "$dev" | md5sum); /usr/lib/devuz/tpm-reseal
[ "$(cryptsetup luksDump "$dev" | md5sum)" = "$before" ] || { say "ERROR перезапечатка при рабочем TPM изменила заголовок"; fail=1; }

if [ "$fail" -eq 0 ]; then say OK; else say FAIL; fi
systemctl start --no-block devuz-selftest.service
