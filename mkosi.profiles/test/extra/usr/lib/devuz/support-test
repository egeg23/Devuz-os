#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# Тест канала поддержки (только тестовый образ, режим
# devuz.test=support,<адрес Headscale>,<ключ входа>):
#  1. по умолчанию канал выключен;
#  2. devuz-support on — коробка вошла в Headscale (адрес 100.64.x.x);
#  3. devuz-support off — клиент остановлен, интерфейса tailscale0 нет.
# Потом — обычная самопроверка.
set -u
say() { echo "DEVUZ-SUPPORT-TEST $*"; }
fail=0
server=${1:?адрес Headscale}
key=${2:?ключ входа}
unit=devuz-svc-tailscale.service

# Тестовый адрес — только сервер на раннере (как и у теста обновлений).
case "$server" in http://10.0.2.2:[0-9]*) ;; *) say "ERROR адрес не тестовый: $server"; exit 1 ;; esac
mkdir -p /etc/devuz
umask 077
printf 'TS_AUTHKEY=%s\nTS_EXTRA_ARGS=--login-server=%s\n' "$key" "$server" >/etc/devuz/support.env

if [ "$(devuz-support status)" = off ] && ! systemctl is-active --quiet "$unit"; then
    say "OFF_BY_DEFAULT ok"
else
    say "ERROR канал включён без кнопки"; fail=1
fi

if devuz-support on; then
    ip4=$(podman exec devuz-tailscale tailscale ip -4 2>/dev/null | head -n1)
    case "$ip4" in 100.*) say "ON ok: коробка в сети поддержки, $ip4" ;; *) say "ERROR нет адреса в сети поддержки: '$ip4'"; fail=1 ;; esac
else
    say "ERROR devuz-support on не удалось:"; journalctl -b -u "$unit" --no-pager -n 40; fail=1
fi

devuz-support off
if ! systemctl is-active --quiet "$unit" && ! ip link show tailscale0 >/dev/null 2>&1; then
    say "OFF ok: клиент остановлен, tailscale0 нет"
else
    say "ERROR после выключения канал жив"; fail=1
fi
grep -q 'включён' /var/lib/devuz/support.log && grep -q 'выключен' /var/lib/devuz/support.log &&
    say "JOURNAL ok: $(wc -l </var/lib/devuz/support.log) записи в журнале клиента" || { say "ERROR нет записей в журнале"; fail=1; }

if [ "$fail" -eq 0 ]; then say OK; else say FAIL; fi
systemctl start --no-block devuz-selftest.service
