#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# Тест «Ядра» (только тестовый образ, режим devuz.test=core). Модель —
# поддельная (devuz-svc-mockllm): проверяем само «Ядро», а не модель.
#  1. без токена — 401; с токеном — ответ, учёт записан;
#  2. задача не из прав приложения — 403;
#  3. повысить себе приоритет нельзя;
#  4. очередь: живой запрос обгоняет ночной; полная очередь — сразу 429;
#  5. модель молчит — 504 через timeout_s; обрыв ответа — клиент не висит;
#     брошенный в очереди запрос до модели не доходит;
#  6. в учёте нет текста запросов.
# Потом — обычная самопроверка.
set -u
say() { echo "DEVUZ-CORE-TEST $*"; }
fail=0
api=http://127.0.0.1:8090/v1
apps=/etc/devuz/core/apps.d

for _ in $(seq 120); do curl -fsS "$api/health" >/dev/null 2>&1 && break; sleep 1; done
curl -fsS "$api/health" >/dev/null || { say "ERROR «Ядро» не отвечает"; journalctl -b -u devuz-svc-core.service --no-pager -n 30; say FAIL; systemctl start --no-block devuz-selftest.service; exit 1; }

# Приложения: токен у приложения, на коробке — только sha256.
mk() { # имя приоритет задачи(json)
    local tok; tok=$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')
    printf '{"token_sha256":"%s","tasks":%s,"priority":"%s"}\n' "$(printf %s "$tok" | sha256sum | cut -d' ' -f1)" "$3" "$2" >"$apps/$1.json"
    echo "$tok"
}
mkdir -p "$apps"
t_staff=$(mk test-staff staff '["chat"]')
t_night=$(mk test-night night '["chat"]')
t_live=$(mk test-live live '["chat"]')
systemctl reload devuz-svc-core.service
sleep 1

ask() { # токен текст [доп. заголовок] [задача]
    curl -s -m 15 -o /tmp/core.out -w '%{http_code}' -H "authorization: Bearer $1" -H 'content-type: application/json' ${3:+-H "$3"} \
        -d "{\"model\":\"${4:-chat}\",\"messages\":[{\"role\":\"user\",\"content\":\"$2\"}]}" "$api/chat/completions"
}

# 1. Токен.
c=$(curl -s -o /dev/null -w '%{http_code}' -d '{}' "$api/chat/completions")
c2=$(curl -s -o /dev/null -w '%{http_code}' -H 'authorization: Bearer чужой' -d '{}' "$api/chat/completions")
[ "$c" = 401 ] && [ "$c2" = 401 ] && say "NO_TOKEN_401 ok" || { say "ERROR без токена: $c, чужой токен: $c2"; fail=1; }
c=$(ask "$t_staff" "привет")
if [ "$c" = 200 ] && grep -q 'model=mock-chat' /tmp/core.out; then
    say "CHAT ok: задача chat → модель mock-chat"
else
    say "ERROR chat: $c $(cat /tmp/core.out)"; fail=1
fi
# Вход в формате Anthropic (SDK студии): токен в x-api-key, ответ — сообщение Anthropic.
c=$(curl -s -o /tmp/core.A -w '%{http_code}' -H "x-api-key: $t_staff" -H 'anthropic-version: 2023-06-01' -H 'content-type: application/json' \
    -d '{"model":"chat","max_tokens":16,"system":"кратко","messages":[{"role":"user","content":[{"type":"text","text":"привет"}]}]}' "$api/messages")
if [ "$c" = 200 ] && grep -q '"type":"message"' /tmp/core.A && grep -q 'model=mock-chat' /tmp/core.A; then
    say "ANTHROPIC ok: /v1/messages → сообщение Anthropic"
else
    say "ERROR вход Anthropic: $c $(head -c 300 /tmp/core.A)"; fail=1
fi
sleep 1
usage=$(cat /var/lib/devuz/core/usage-*.jsonl 2>/dev/null)
grep -q '"app":"test-staff","task":"chat"' <<<"$usage" && say "USAGE ok: $(tail -n1 <<<"$usage")" || { say "ERROR нет записи в учёте"; fail=1; }

# 2. Чужая задача.
c=$(ask "$t_staff" "код" "" code)
[ "$c" = 403 ] && say "FORBIDDEN_403 ok: $(cat /tmp/core.out)" || { say "ERROR задача без права: $c"; fail=1; }

# 3. Повысить приоритет нельзя.
p=$(curl -s -D - -o /dev/null -H "authorization: Bearer $t_night" -H 'x-devuz-priority: live' -H 'content-type: application/json' \
    -d '{"model":"chat","messages":[{"role":"user","content":"x"}]}' "$api/chat/completions" | tr -d '\r' | sed -n 's/^x-devuz-priority: //Ip')
[ "$p" = night ] && say "NO_PRIORITY_RAISE ok" || { say "ERROR приоритет поднялся до «$p»"; fail=1; }

# 4. Очередь: модель занята ночным A; встают ночной B и живой C (max_queue 2);
#    четвёртый D получает 429 сразу.
ask "$t_night" "sleep:3 A" >/dev/null & a=$!
sleep 1
curl -s -m 15 -o /tmp/core.B -H "authorization: Bearer $t_night" -H 'content-type: application/json' \
    -d '{"model":"chat","messages":[{"role":"user","content":"B"}]}' "$api/chat/completions" & b=$!
sleep 0.3
curl -s -m 15 -o /tmp/core.C -H "authorization: Bearer $t_live" -H 'content-type: application/json' \
    -d '{"model":"chat","messages":[{"role":"user","content":"C"}]}' "$api/chat/completions" & c=$!
sleep 0.3
d=$(curl -s -m 5 -o /tmp/core.D -D /tmp/core.Dh -w '%{http_code}' -H "authorization: Bearer $t_staff" -H 'content-type: application/json' \
    -d '{"model":"chat","messages":[{"role":"user","content":"D"}]}' "$api/chat/completions")
wait $a $b $c
oB=$(grep -o 'order=[0-9]*' /tmp/core.B | cut -d= -f2); oC=$(grep -o 'order=[0-9]*' /tmp/core.C | cut -d= -f2)
if [ -n "$oB" ] && [ -n "$oC" ] && [ "$oC" -lt "$oB" ]; then
    say "QUEUE ok: живой обработан $oC-м, ночной $oB-м"
else
    say "ERROR очередь: живой ${oC:-?}, ночной ${oB:-?}"; fail=1
fi
[ "$d" = 429 ] && grep -qi '^retry-after:' /tmp/core.Dh && say "QUEUE_FULL_429 ok" || { say "ERROR полная очередь: $d $(cat /tmp/core.D)"; fail=1; }

#    Модель занята дольше max_wait_s (3 с в тестовой таблице) — ждущий
#    получает 503 с Retry-After, а не висит.
ask "$t_night" "sleep:4 hold" >/dev/null & a=$!
sleep 0.5
t0=$(date +%s); c=$(curl -s -m 10 -o /tmp/core.W -D /tmp/core.Wh -w '%{http_code}' -H "authorization: Bearer $t_staff" -H 'content-type: application/json' \
    -d '{"model":"chat","messages":[{"role":"user","content":"W"}]}' "$api/chat/completions"); dt=$(( $(date +%s) - t0 ))
wait $a
[ "$c" = 503 ] && [ "$dt" -le 5 ] && grep -qi '^retry-after:' /tmp/core.Wh && say "QUEUE_WAIT_503 ok: ${dt} с" || { say "ERROR долгое ожидание в очереди: $c за ${dt} с $(cat /tmp/core.W)"; fail=1; }

# 5. Модель молчит — 504 через timeout_s (5 с в тестовой таблице).
t0=$(date +%s); c=$(ask "$t_staff" "silent"); dt=$(( $(date +%s) - t0 ))
[ "$c" = 504 ] && [ "$dt" -le 10 ] && say "TIMEOUT_504 ok: ${dt} с" || { say "ERROR модель молчит: $c за ${dt} с"; fail=1; }
#    Обрыв ответа посередине — клиент получает обрыв, а не ждёт вечно; место в очереди свободно.
t0=$(date +%s); curl -s -m 15 -o /dev/null -H "authorization: Bearer $t_staff" -H 'content-type: application/json' \
    -d '{"model":"chat","messages":[{"role":"user","content":"abort"}]}' "$api/chat/completions"; rc=$?; dt=$(( $(date +%s) - t0 ))
c=$(ask "$t_staff" "after-abort")
[ "$rc" -ne 0 ] && [ "$rc" -ne 28 ] && [ "$dt" -le 5 ] && [ "$c" = 200 ] && say "ABORT ok: curl $rc за ${dt} с, потом 200" || { say "ERROR обрыв: curl $rc за ${dt} с, следующий $c"; fail=1; }
#    Брошенный в очереди запрос до модели не доходит.
ask "$t_staff" "sleep:2 busy" >/dev/null & a=$!
sleep 0.5
curl -s -m 0.5 -o /dev/null -H "authorization: Bearer $t_staff" -H 'content-type: application/json' \
    -d '{"model":"chat","messages":[{"role":"user","content":"GONE-q"}]}' "$api/chat/completions"
wait $a; sleep 1
if curl -s http://127.0.0.1:8091/seen | grep -q 'GONE-q'; then say "ERROR брошенный запрос дошёл до модели"; fail=1; else say "GONE_SKIPPED ok"; fi

# 6. В учёте нет текста запросов.
if cat /var/lib/devuz/core/usage-*.jsonl | grep -q -e 'привет' -e 'GONE-q'; then say "ERROR в учёте текст запроса"; fail=1; else say "USAGE_NO_TEXT ok"; fi

# 7. Класс коробки: тестовая ВМ маленькая — Лайт; без тестовой таблицы «Ядро»
#    берёт tasks.lite.json, а на видео отвечает, на какой коробке оно есть.
cls=$(sed -n 's/.*"class":"\([a-z-]*\)".*/\1/p' /run/devuz/box/box.json 2>/dev/null)
mv /etc/devuz/core/tasks.json /run/core-tasks.test.json
systemctl reload devuz-svc-core.service; sleep 1
hc=$(curl -s -m 5 "$api/health" | sed -n 's/.*"box_class":"\([a-z-]*\)".*/\1/p')
c=$(ask "$t_staff" "кадр" "" video)
if [ "$cls" = lite ] && [ "$hc" = lite ] && [ "$c" = 404 ] && grep -q 'Джарвис' /tmp/core.out; then
    say "BOX_CLASS ok: класс lite, таблица tasks.lite.json, видео — $(sed -n 's/.*"message":"\([^"]*\)".*/\1/p' /tmp/core.out)"
else
    say "ERROR класс коробки: box.json «$cls», «Ядро» «$hc», видео $c $(cat /tmp/core.out)"; fail=1
fi
mv /run/core-tasks.test.json /etc/devuz/core/tasks.json
systemctl reload devuz-svc-core.service; sleep 1

rm -f "$apps"/test-*.json
if [ "$fail" -eq 0 ]; then say OK; else say FAIL; fi
systemctl start --no-block devuz-selftest.service
