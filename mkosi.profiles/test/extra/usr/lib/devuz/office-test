#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# Тест места под «Офис» (только тестовый образ, режим devuz.test=office).
# Заглушка «Офиса» (tests/office-stub) лежит в тестовом реестре на раннере под
# именем ghcr.io/egeg23/devuz-office:v1 с тестовой подписью.
#  1. «Офис» включается файлом, образ берётся из реестра с проверкой подписи;
#  2. открывается через Caddy (https://localhost/);
#  3. ходит в «Ядро» по сокету со своим токеном (вход Anthropic);
#  4. токен — 0600, в «Ядре» — только отпечаток с приоритетом live; код
#     первого входа — 0600 и не в журнале;
#  5. образ без подписи и подписанный чужим ключом — отказ по подписи;
#  6. выход наружу: внешний вход Caddy только на 127.0.0.1, пометка
#     «снаружи» не подделывается ни снаружи, ни из сети офиса; туннель
#     выключен по умолчанию, включается только с ключом правильной формы,
#     ключ 0600, адрес снаружи — «Офису»;
#  7. «Офис» остановлен — Caddy показывает страницу коробки.
set -u
say() { echo "DEVUZ-OFFICE-TEST $*"; }
fail=0
ca=/var/lib/devuz/caddy/caddy/pki/authorities/local/root.crt
for i in $(seq 60); do systemctl is-active --quiet devuz-svc-caddy.service devuz-svc-core.service && break; sleep 2; done
mkdir -p /etc/devuz/office && touch /etc/devuz/office/enabled
if systemctl start devuz-svc-office.service && systemctl is-active --quiet devuz-svc-office.service; then
    say "STARTED ok: $(podman image inspect --format '{{.Id}}' ghcr.io/egeg23/devuz-office:v1 | cut -c1-12)"
else
    say "ERROR «Офис» не запустился:"; journalctl -b -u devuz-svc-office.service --no-pager -n 40; fail=1
fi
body=$(curl -s --cacert "$ca" https://localhost/)
case "$body" in *"Офис"*"данные пишутся: да"*) say "VIA_CADDY ok: $body" ;; *) say "ERROR через Caddy: «$body»"; fail=1 ;; esac
c=$(curl -s -o /tmp/office.ai -w '%{http_code}' --cacert "$ca" https://localhost/api/ai)
if [ "$c" = 200 ] && grep -q '"type":"message"' /tmp/office.ai; then say "CORE_FROM_OFFICE ok: $(head -c 160 /tmp/office.ai)"; else say "ERROR «Офис» → «Ядро»: $c $(head -c 300 /tmp/office.ai)"; fail=1; fi
m=$(stat -c %a /etc/devuz/office/core-token 2>/dev/null)
if [ "$m" = 600 ] && grep -q '"priority":"live"' /etc/devuz/core/apps.d/office.json && ! grep -qF "$(cat /etc/devuz/office/core-token)" /etc/devuz/core/apps.d/office.json; then
    say "TOKEN ok: 0600, в «Ядре» только отпечаток"
else
    say "ERROR токен: права $m"; fail=1
fi
sc=$(cat /etc/devuz/office/setup-code 2>/dev/null)
if [ "$(stat -c %a /etc/devuz/office/setup-code 2>/dev/null)" = 600 ] && [[ "$sc" =~ ^[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}$ ]] && ! journalctl -b --no-pager | grep -qF "$sc"; then
    say "SETUP_CODE ok: 0600, в журнале его нет"
else
    say "ERROR код первого входа: права $(stat -c %a /etc/devuz/office/setup-code 2>&1)"; fail=1
fi
# База «Офиса»: роль office входит по паролю в свою базу; без пароля и в чужую базу — нет.
pw=$(cat /etc/devuz/office/db-password 2>/dev/null)
q() { podman exec -e PGPASSWORD="$1" devuz-postgres psql -h /var/run/postgresql -U office -d "$2" -tAc 'select current_user' 2>&1; }
ok=$(q "$pw" office); bad=$(q nope office); other=$(q "$pw" postgres)
if [ "$ok" = office ] && [ "$(stat -c %a /etc/devuz/office/db-password)" = 600 ] && [ "$bad" != office ] && [ "$other" != office ]; then
    say "DB ok: роль office в своей базе, чужой пароль и чужая база — отказ"
else
    say "ERROR база «Офиса»: «$ok» / «$bad» / «$other»"; fail=1
fi
# Образ без нашей подписи и подписанный чужим ключом коробка не берёт: отказ
# должен быть именно из-за подписи (а не из-за сети), и образа после него нет.
for t in unsigned foreign; do
    out=$(podman pull "ghcr.io/egeg23/devuz-office:$t" 2>&1); prc=$?
    k=$([ "$t" = unsigned ] && echo UNSIGNED_REFUSED || echo FOREIGN_KEY_REFUSED)
    if [ "$prc" -ne 0 ] && printf '%s' "$out" | grep -qi 'signature' && ! podman image exists "ghcr.io/egeg23/devuz-office:$t"; then
        say "$k ok: $(printf '%s' "$out" | grep -i -m1 'signature' | cut -c1-160)"
    else
        say "ERROR образ «$t» не отвергнут: код $prc, $(printf '%s' "$out" | tail -n1 | cut -c1-200)"; fail=1
    fi
done
# --- выход наружу ---
if ss -Hltn 'sport = :8180' | awk '{print $4}' | grep -qvx '127.0.0.1:8180'; then
    say "ERROR внешний вход слушает не только 127.0.0.1: $(ss -Hltn 'sport = :8180')"; fail=1
elif ss -Hltn 'sport = :8180' | grep -q .; then
    say "EXTERNAL_LOCAL_ONLY ok: $(ss -Hltn 'sport = :8180' | awk '{print $4}' | xargs)"
else
    say "ERROR внешнего входа :8180 нет"; fail=1
fi
# Через туннель приходит внешнее имя коробки — внешний вход принимает любое имя.
out=$(curl -s -H 'Host: box-test.devuz.example' -H 'X-Devuz-Via: inside' -H 'Cf-Connecting-IP: 203.0.113.7' http://127.0.0.1:8180/api/via)
inn=$(curl -s --cacert "$ca" -H 'X-Devuz-Via: tunnel' https://localhost/api/via)
if [[ "$out" == *'"via":"tunnel"'* && "$out" == *'"ip":"203.0.113.7"'* && "$inn" == *'"via":""'* ]]; then
    say "VIA_MARK ok: снаружи $out, из офиса $inn"
else
    say "ERROR пометка «снаружи»: снаружи «$out», из офиса «$inn»"; fail=1
fi
tun=devuz-svc-cloudflared.service
if [ "$(devuz-tunnel status)" = off ] && ! systemctl is-active --quiet "$tun" && podman image exists ghcr.io/egeg23/devuz-cloudflared:2026.10.1; then
    say "TUNNEL_OFF_BY_DEFAULT ok (образ в /usr)"
else
    say "ERROR туннель: $(devuz-tunnel status), образ: $(podman image exists ghcr.io/egeg23/devuz-cloudflared:2026.10.1 && echo есть || echo нет)"; fail=1
fi
if printf 'not-a-token' | devuz-tunnel on https://box-test.devuz.example 2>/tmp/tun.err; then
    say "ERROR туннель включился с плохим ключом"; fail=1
elif printf '%s' "$(printf '{"a":"%032d","t":"x","s":"y"}' 0 | base64 -w0)" | devuz-tunnel on https://box-test.devuz.example 2>>/tmp/tun.err; then
    say "ERROR туннель включился с ключом без номера туннеля"; fail=1
elif printf 'x' | devuz-tunnel on http://box-test.devuz.example 2>>/tmp/tun.err; then
    say "ERROR туннель включился с адресом http"; fail=1
elif [ "$(devuz-tunnel status)" = off ]; then
    say "TUNNEL_BAD_REFUSED ok: $(head -n1 /tmp/tun.err)"
else
    say "ERROR после отказа туннель: $(devuz-tunnel status)"; fail=1
fi
# Ключ правильной формы (не настоящий): cloudflared стартует с нашим номером
# туннеля и стучится в Cloudflare (войти он не сможет — ключ выдуман).
tid=0b6f1a2c-3d4e-4f50-8a9b-0c1d2e3f4a5b
tok=$(printf '{"a":"%032d","t":"%s","s":"%s"}' 0 "$tid" "$(head -c 32 /dev/urandom | base64 -w0)" | base64 -w0)
# Ключ ищем в командных строках процессов через файл-образец: в аргументах самого grep его нет.
( umask 077; printf '%s\n' "$tok" >/run/tok.pat )
if printf '%s\n' "$tok" | devuz-tunnel on https://box-test.devuz.example; then
    for i in $(seq 30); do journalctl -b -u "$tun" --no-pager | grep -q "$tid" && break; sleep 2; done
    if journalctl -b -u "$tun" --no-pager | grep -q "$tid" && [ "$(stat -c %a /etc/devuz/tunnel/token)" = 600 ] &&
       [ "$(cat /etc/devuz/office/public-url)" = https://box-test.devuz.example ] && ! grep -qaF -f /run/tok.pat /proc/[0-9]*/cmdline 2>/dev/null; then
        say "TUNNEL_STARTS ok: cloudflared с туннелем $tid, ключ 0600 и не в списке процессов, адрес — «Офису»"
    else
        say "ERROR туннель: права $(stat -c %a /etc/devuz/tunnel/token), адрес «$(cat /etc/devuz/office/public-url 2>&1)»"; journalctl -b -u "$tun" --no-pager -n 30; fail=1
    fi
else
    say "ERROR devuz-tunnel on не удалось"; journalctl -b -u "$tun" --no-pager -n 30; fail=1
fi
rm -f /run/tok.pat
devuz-tunnel off
if ! systemctl is-active --quiet "$tun" && ! systemctl is-failed --quiet "$tun" && [ "$(devuz-tunnel status)" = off ] && grep -q 'выход наружу включён' /var/lib/devuz/tunnel.log; then
    say "TUNNEL_OFF ok"
else
    say "ERROR после выключения туннель: $(devuz-tunnel status)"; fail=1
fi

systemctl stop devuz-svc-office.service
body=$(curl -s --cacert "$ca" https://localhost/)
[ "$body" = "DevUz OK" ] && say "FALLBACK ok" || { say "ERROR без «Офиса»: «$body»"; fail=1; }
[ "$fail" = 0 ] && say "OK" || say "FAIL"
systemctl start --no-block devuz-selftest.service
